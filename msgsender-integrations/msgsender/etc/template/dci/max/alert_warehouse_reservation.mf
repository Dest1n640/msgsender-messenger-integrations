{# vim: set ft=jinja: #}

{%- extends "dci/max/base.jinja" -%}

{%- set ns = namespace() -%}

{%- set ns.date_shift = params.message.component.date_shift -%}
{%- set entity_name = params.message.component.entity -%}
{%- set entity_counter = params.message.component.barcodes|length -%}
{%- set ns.identical_date = params.message.component.identical_date -%}

{%- include "dci/common/entity_type.jinja" with context -%}

{%- set day_word = ngettext("DAY", "DAYS", ns.date_shift) -%}

{%- set entity_readable_name = params.message.component.barcodes[0] -%}
{%- if entity_name == "other" -%}
    {%- set entity_readable_name = params.message.component.other_name -%}
{%- endif -%}

{%- set ns.title = ngettext(
    "WAREHOUSE_ENTITY_RESERVATION_EXPIRING_OR_EXPIRED",
    "WAREHOUSE_ENTITY_RESERVATION_EXPIRING_OR_EXPIRED_PLURAL",
    entity_counter,
    count=entity_counter,
) -%}
{%- set ns.body_message = gettext("WAREHOUSE_ENTITY_RESERVATION_VARIES.") -%}

{%- if ns.identical_date -%}
    {%- set ns.body_message = "" -%}
    {%- if ns.date_shift > 0 -%}
        {%- set ns.title = ngettext(
            "WAREHOUSE_ENTITY_RESERVATION_WILL_EXPIRED_IN_DAYS",
            "WAREHOUSE_ENTITY_RESERVATION_WILL_EXPIRED_IN_DAYS_PLURAL",
            entity_counter,
            count=entity_counter,
            days=ns.date_shift,
            day_word=day_word
        ) -%}
    {%- else -%}
        {%- set ns.title = ngettext(
            "WAREHOUSE_ENTITY_RESERVATION_EXPIRED",
            "WAREHOUSE_ENTITY_RESERVATION_EXPIRED_PLURAL",
            entity_counter,
            count=entity_counter,
            days=ns.date_shift,
            day_word=day_word
        ) -%}
    {%- endif -%}
{%- endif -%}

{%- block header -%}
{{ ns.title }}
{%- endblock header -%}

{%- block body -%}
{{ ns.body_message }}
{{ gettext("LOCATION:") }} {{ params.message.component.warehouse_name }}
{{ gettext("WAREHOUSE_ENTITY_TYPE:") }} {{ ns.entity_type }}
{{ gettext("WAREHOUSE_ENTITY_COUNT:") }} {{ entity_counter }}
{% if entity_counter == 1 -%}
    {{ gettext("BARCODE:") }} {{ entity_readable_name }}
{% endif -%}

{% if ns.identical_date and ns.date_shift > 0 -%}
    {{ gettext("RESERVED_UNTIL:") }} {{ params.message.component.end_date }}
{%- endif %}

{% include 'dci/common/warehouse_entity_link.jinja' with context -%}
{%- endblock body -%}
